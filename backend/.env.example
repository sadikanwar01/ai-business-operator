# ---------------------------------------------------------------------------
# AI Business Operator - environment template
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# Every value here is a placeholder. Credentials are read on the server only
# and are never sent to the browser.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="AI Business Operator"
ENVIRONMENT=development
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
TOKEN_TTL_DAYS=30

# --- Storage --------------------------------------------------------------
DATABASE_PATH=./data/operator.db

# --- AI provider: Nebius Token Factory -----------------------------------
# Leave NEBIUS_API_KEY empty to run the deterministic Demo provider.
# The Demo provider implements the same interface, so nothing else changes.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
# NVIDIA Nemotron models served through Nebius AI Studio. Any other model
# id available on the endpoint works as well.
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-Nano-8B-v1
NEBIUS_TIMEOUT=90
NEBIUS_MAX_TOKENS=2048

# Set to true to force the Demo provider even when a key is present.
FORCE_DEMO_PROVIDER=false

# Seconds each demo agent "thinks" per step. Lower it for faster walkthroughs.
DEMO_STEP_DELAY=1.1

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
